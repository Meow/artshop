{
  "name": "artshop",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "node server.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.tsx",
    "build:client": "vite build --outDir dist/client --ssrManifest",
    "start": "node server.ts --production",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --report-unused-disable-directives --max-warnings 0",
    "fmt": "prettier --write ."
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@csstools/postcss-relative-color-syntax": "^4.0.9",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "normalize.css": "^8.0.1",
    "oxlint": "^1.80.0",
    "postcss": "^8.5.26",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
